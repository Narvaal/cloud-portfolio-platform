# Copy this file to .env.production and fill in the values.
# .env.production is gitignored — never commit it.
# In CI/CD, VITE_API_BASE_URL is read from SSM /portfolio/config/api-base-url.
# Never put secrets here: VITE_* values are inlined into the public bundle.

VITE_API_BASE_URL=https://<api-gateway-id>.execute-api.<region>.amazonaws.com/prod
